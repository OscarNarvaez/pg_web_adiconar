# Copia este archivo a .env.local (ignorado por git) y completa con los
# valores de tu proyecto Supabase: Project Settings → API.
# Usa siempre la clave "anon public" / "publishable" (nunca la "service_role").
#
# Importante: este proyecto usa Vite, no Next.js — Vite solo expone al
# cliente las variables que empiezan con "VITE_" (no "NEXT_PUBLIC_").
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key
